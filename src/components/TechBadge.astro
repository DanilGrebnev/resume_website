---
import styles from './TechBadge.module.css';

interface Props { technology: string }
const { technology } = Astro.props;
const icons: Record<string, string> = {
  React: 'react',
  'Next.js': 'nextdotjs',
  Astro: 'astro',
  TypeScript: 'typescript',
  'Motion UI': 'motion',
  Express: 'express',
  NestJS: 'nestjs',
  Python: 'python',
  asyncio: 'asyncio',
  PostgreSQL: 'postgresql',
  MongoDB: 'mongodb',
};
const icon = icons[technology];
---
<span class={styles.badge}>
  {icon && <span class={styles.icon} style={`--tech-icon: url('/icons/${icon}.svg')`} aria-hidden="true"></span>}
  <span>{technology}</span>
</span>
