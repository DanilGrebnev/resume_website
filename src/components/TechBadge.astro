---
import styles from './TechBadge.module.scss';

interface Props { technology: string }
const { technology } = Astro.props;
const icons: Record<string, string> = {
  React: 'react',
  'Next.js': 'nextdotjs',
  Astro: 'astro',
  TypeScript: 'typescript',
  'Motion UI': 'motion',
  Express: 'express',
  NestJS: 'nestjs',
  Python: 'python',
  FastAPI: 'fastapi',
  asyncio: 'asyncio',
  PostgreSQL: 'postgresql',
  MongoDB: 'mongodb',
  WordPress: 'wordpress',
  JavaScript: 'javascript',
  SCSS: 'sass',
  'SCSS Modules': 'sass',
  jQuery: 'jquery',
  GSAP: 'gsap',
  Swiper: 'swiper',
  Inputmask: 'inputmask',
  Zustand: 'zustand',
  Axios: 'axios',
};
const icon = icons[technology];
---
<span class={styles.badge}>
  {icon && <span class={styles.icon} style={`--tech-icon: url('/icons/${icon}.svg')`} aria-hidden="true"></span>}
  <span>{technology}</span>
</span>
