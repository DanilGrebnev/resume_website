---
import { portfolio as p } from '../data/portfolio';
import ProjectCard from '../components/ProjectCard.astro';
import TechBadge from '../components/TechBadge.astro';
import HeroGraphic from '../components/HeroGraphic.astro';
import styles from '../styles/Home.module.scss';
import '../styles/global.scss';
const year = new Date().getFullYear();
const canonical = p.seo.siteUrl ? new URL('/', p.seo.siteUrl).href : null;
const ogImage = p.seo.siteUrl ? new URL('/og.png', p.seo.siteUrl).href : '/og.png';
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#171918" />
    <meta name="description" content={p.seo.description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={p.seo.title} />
    <meta property="og:description" content={p.seo.description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Портфолио разработчика — code, craft, character" />
    {canonical && <><link rel="canonical" href={canonical} /><meta property="og:url" content={canonical} /></>}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{p.seo.title}</title>
  </head>
  <body>
    <a class={styles.skip} href="#main">Перейти к содержимому</a>
    <div class={styles.shell}>
      <header class={styles.header}>
        <a href="#" class={styles.logo} aria-label="На главную"><span class={styles.logoIcon}>[ / ]</span><span>DEV<span class={styles.logoDot}>.</span>FOLIO</span></a>
        <nav class={styles.nav} aria-label="Основная навигация"><a href="#about">Обо мне</a><a href="#stack">Стек</a><a href="#projects">Проекты</a></nav>
        <a href="#contact" class={styles.headerContact}>На связи <span>↗</span></a>
      </header>
      <main id="main">
        <section class={styles.hero} aria-labelledby="hero-title">
          <div class={styles.heroEyebrow}><span class={styles.dot}></span> ПОРТФОЛИО РАЗРАБОТЧИКА <span class={styles.edition}>VOL. 01 / {year}</span></div>
          <div class={styles.heroLayout}>
            <div class={styles.heroContent}>
              <p class={styles.hello}>Привет, я</p>
              <h1 id="hero-title">{p.name}<span class={styles.titleDot}>.</span></h1>
              <p class={styles.specialization}><span>↳</span> {p.specialization}</p>
              <p class={styles.positioning}>{p.positioning}</p>
              <div class={styles.heroActions}><a class={styles.primary} href="#projects">Мои проекты <span>↗</span></a><a class={styles.secondary} href="#contact">Связаться <span>↗</span></a></div>
            </div>
            <HeroGraphic />
          </div>
          <div class={styles.heroBottom}><span>ОТ ИДЕИ — К РАБОТАЮЩЕМУ ПРОДУКТУ</span><a href="#about">Листайте, здесь больше <span>↓</span></a></div>
        </section>

        <section id="about" class={styles.section} aria-labelledby="about-title">
          <div class={styles.sectionHeading} data-reveal><p class={styles.kicker}><span>01 /</span> ОБО МНЕ</p><span class={styles.sideNote}>ЧЕЛОВЕК ЗА КОДОМ</span></div>
          <div class={styles.aboutLayout}>
            <h2 id="about-title" data-reveal>Хороший код.<br /><span>Осмысленный</span><br />результат.</h2>
            <div class={styles.aboutCopy} data-reveal>{p.about.map(text => <p>{text}</p>)}<div class={styles.signature}><span>↳</span> {p.name} / {p.specialization}</div></div>
          </div>
          <div class={styles.directions}>{p.directions.map((item, index) => <div data-reveal><span class={styles.directionNumber}>0{index + 1}</span><h3>{item.title}</h3><p>{item.description}</p></div>)}</div>
        </section>

        <section id="stack" class={styles.section} aria-labelledby="stack-title">
          <div class={styles.sectionHeading} data-reveal><p class={styles.kicker}><span>02 /</span> ТЕХНОЛОГИИ</p><span class={styles.sideNote}>МОЙ РАБОЧИЙ НАБОР</span></div>
          <div class={styles.stackIntro} data-reveal><h2 id="stack-title">Инструменты.<br /><span>Под задачу.</span></h2><p>Технологии, с которыми я работаю.<br />Без процентов и условных рейтингов.</p></div>
          <div class={styles.stackList}>{p.stack.map((group, index) => <div class={styles.stackRow} data-reveal><span class={styles.stackNumber}>0{index + 1}</span><h3>{group.title}</h3><div class={styles.technologies}>{group.technologies.length ? group.technologies.map(tech => <TechBadge technology={tech} />) : <p>{group.placeholder}</p>}</div><span class={styles.stackPlus} aria-hidden="true">+</span></div>)}</div>
        </section>

        <section id="projects" class={styles.section} aria-labelledby="projects-title">
          <div class={styles.sectionHeading} data-reveal><p class={styles.kicker}><span>03 /</span> ИЗБРАННЫЕ ПРОЕКТЫ</p><span class={styles.sideNote}>ИДЕИ В ДЕЙСТВИИ</span></div>
          <div class={styles.projectsIntro} data-reveal><h2 id="projects-title">Меньше слов.<br /><span>Больше дела.</span></h2><p>Задачи, решения и детали работы.{p.projects.some(project => project.title.startsWith('[')) && <><br /><span class={styles.contentNote}>Сейчас здесь заполнители ваших проектов.</span></>}</p></div>
          <div class={styles.projectsGrid}>{p.projects.map((project, index) => <ProjectCard project={project} featured={index === 0 || index === 5} />)}</div>
        </section>

        <section id="contact" class={styles.contact} aria-labelledby="contact-title">
          <div class={styles.sectionHeading} data-reveal><p class={styles.kicker}><span>04 /</span> КОНТАКТЫ</p><span class={styles.contactSpark} aria-hidden="true">✳</span></div>
          <div class={styles.contactLayout} data-reveal><h2 id="contact-title">Есть идея?<br />Давайте <span>обсудим<span class={styles.contactArrow} aria-hidden="true">↗</span></span></h2><p>Расскажите о вашем проекте,<br />{' '}задаче или предложении.<br />{' '}<span>Начнём с простого «привет».</span></p></div>
            <div class={styles.contactLinks}>{p.contacts.map(contact => contact.href ? <a href={contact.href} target={contact.href.startsWith('mailto:') ? undefined : '_blank'} rel="noopener noreferrer"><span>{contact.label}</span><span>{contact.value}</span><span aria-hidden="true">↗</span></a> : <div class={styles.contactPlaceholder}><span>{contact.label}</span><span>{contact.value}</span><span aria-hidden="true">↗</span><span class={styles.srOnly}> — контакт пока не указан</span></div>)}</div>
        </section>
      </main>
      <footer class={styles.footer}><span>© {year} {p.name}</span><span>Собрано с вниманием к деталям.</span><a href="#">Наверх ↑</a></footer>
    </div>
    <script>
      const elements = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (!motionQuery.matches && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(entries => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.removeAttribute('data-pending');
              observer.unobserve(entry.target);
            }
          }
        }, { threshold: 0.08 });
        elements.forEach(element => {
          if (element.getBoundingClientRect().top > window.innerHeight) element.setAttribute('data-pending', '');
          observer.observe(element);
        });
        motionQuery.addEventListener('change', event => {
          if (event.matches) {
            elements.forEach(element => element.removeAttribute('data-pending'));
            observer.disconnect();
          }
        });
      }
    </script>
  </body>
</html>
