---
import { portfolios, interfaceCopy } from '../data/portfolio';
import { localePath, type Locale } from '../lib/locale';
import ProjectCard from '../components/ProjectCard.astro';
import TechBadge from '../components/TechBadge.astro';
import HeroGraphic from '../components/HeroGraphic.astro';
import styles from '../styles/Home.module.scss';
import '../styles/global.scss';
interface Props { locale: Locale; detectLocale?: boolean }
const { locale, detectLocale = false } = Astro.props;
const p = portfolios[locale];
const t = interfaceCopy[locale];
const year = new Date().getFullYear();
const canonical = p.seo.siteUrl ? new URL(localePath(locale), p.seo.siteUrl).href : null;
const ogPath = locale === 'ru' ? '/og.png' : '/og-en.png';
const ogImage = p.seo.siteUrl ? new URL(ogPath, p.seo.siteUrl).href : ogPath;
---
<!doctype html>
<html lang={locale} data-auto-locale={detectLocale ? '' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#171918" />
    <meta name="description" content={p.seo.description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'ru' ? 'en_US' : 'ru_RU'} />
    <meta property="og:title" content={p.seo.title} />
    <meta property="og:description" content={p.seo.description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.ogAlt} />
    {canonical && <><link rel="canonical" href={canonical} /><meta property="og:url" content={canonical} /></>}
    {(['ru', 'en'] as const).map(language => <link rel="alternate" hreflang={language} href={p.seo.siteUrl ? new URL(localePath(language), p.seo.siteUrl).href : localePath(language)} />)}
    <link rel="alternate" hreflang="x-default" href={p.seo.siteUrl ? new URL('/', p.seo.siteUrl).href : '/'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{p.seo.title}</title>
  </head>
  <body>
    <a class={styles.skip} href="#main">{t.skip}</a>
    <div class={styles.shell}>
      <header class={styles.header}>
        <a href="#" class={styles.logo} aria-label={t.home}><span class={styles.logoIcon}>[ / ]</span><span>DEV<span class={styles.logoDot}>.</span>FOLIO</span></a>
        <nav class={styles.nav} aria-label={t.navigation}><a href="#about">{t.aboutNav}</a><a href="#stack">{t.stackNav}</a><a href="#projects">{t.projectsNav}</a></nav>
        <div class={styles.headerActions}>
          <nav class={styles.languageSwitch} aria-label={t.languages}>
            <a href="/ru/" lang="ru" hreflang="ru" aria-label={t.russian} aria-current={locale === 'ru' ? 'page' : undefined} data-language-choice="ru">RU</a>
            <a href="/en/" lang="en" hreflang="en" aria-label={t.english} aria-current={locale === 'en' ? 'page' : undefined} data-language-choice="en">EN</a>
          </nav>
          <a href="#contact" class={styles.headerContact} aria-label={t.contactNav} title={t.contactNav}>{t.contactNav} <span aria-hidden="true">↗</span></a>
        </div>
      </header>
      <main id="main">
        <section class={styles.hero} aria-labelledby="hero-title">
          <div class={styles.heroEyebrow}><span class={styles.dot}></span> {t.eyebrow} <span class={styles.edition}>VOL. 01 / {year}</span></div>
          <div class={styles.heroLayout}>
            <div class={styles.heroContent}>
              <p class={styles.hello}>{t.hello}</p>
              <h1 id="hero-title">{p.name}<span class={styles.titleDot}>.</span></h1>
              <p class={styles.specialization}><span>↳</span> {p.specialization}</p>
              <p class={styles.positioning}>{p.positioning}</p>
              <div class={styles.heroActions}><a class={styles.primary} href="#projects">{t.projectsButton} <span>↗</span></a><a class={styles.secondary} href="#contact">{t.contactButton} <span>↗</span></a></div>
            </div>
            <HeroGraphic locale={locale} />
          </div>
          <div class={styles.heroBottom}><span>{t.heroBottom}</span><a href="#about">{t.scroll} <span>↓</span></a></div>
        </section>

        <section id="about" class={styles.section} aria-labelledby="about-title">
          <div class={styles.sectionHeading} data-reveal><p class={styles.kicker}><span>01 /</span> {t.aboutLabel}</p><span class={styles.sideNote}>{t.aboutNote}</span></div>
          <div class={styles.aboutLayout}>
            <h2 id="about-title" data-reveal>{t.aboutTitle1}<br /><span>{t.aboutTitle2}</span><br />{t.aboutTitle3}</h2>
            <div class={styles.aboutCopy} data-reveal>{p.about.map(text => <p>{text}</p>)}<div class={styles.signature}><span>↳</span> {p.name} / {p.specialization}</div></div>
          </div>
          <div class={styles.directions}>{p.directions.map((item, index) => <div data-reveal><span class={styles.directionNumber}>0{index + 1}</span><h3>{item.title}</h3><p>{item.description}</p></div>)}</div>
        </section>

        <section id="stack" class={styles.section} aria-labelledby="stack-title">
          <div class={styles.sectionHeading} data-reveal><p class={styles.kicker}><span>02 /</span> {t.stackLabel}</p><span class={styles.sideNote}>{t.stackNote}</span></div>
          <div class={styles.stackIntro} data-reveal><h2 id="stack-title">{t.stackTitle1}<br /><span>{t.stackTitle2}</span></h2><p>{t.stackIntro1}<br />{t.stackIntro2}</p></div>
          <div class={styles.stackList}>{p.stack.map((group, index) => <div class={styles.stackRow} data-reveal><span class={styles.stackNumber}>0{index + 1}</span><h3>{group.title}</h3><div class={styles.technologies}>{group.technologies.length ? group.technologies.map(tech => <TechBadge technology={tech} />) : <p>{group.placeholder}</p>}</div><span class={styles.stackPlus} aria-hidden="true">+</span></div>)}</div>
        </section>

        <section id="projects" class={styles.section} aria-labelledby="projects-title">
          <div class={styles.sectionHeading} data-reveal><p class={styles.kicker}><span>03 /</span> {t.projectsLabel}</p><span class={styles.sideNote}>{t.projectsNote}</span></div>
          <div class={styles.projectsIntro} data-reveal><h2 id="projects-title">{t.projectsTitle1}<br /><span>{t.projectsTitle2}</span></h2><p>{t.projectsIntro}{p.projects.some(project => project.title.startsWith('[')) && <><br /><span class={styles.contentNote}>{t.projectPlaceholder}</span></>}</p></div>
          <div class={styles.projectsGrid}>{p.projects.map((project, index) => <ProjectCard project={project} locale={locale} featured={index === 0 || index === 5} />)}</div>
        </section>

        <section id="contact" class={styles.contact} aria-labelledby="contact-title">
          <div class={styles.sectionHeading} data-reveal><p class={styles.kicker}><span>04 /</span> {t.contactLabel}</p><span class={styles.contactSpark} aria-hidden="true">✳</span></div>
          <div class={styles.contactLayout} data-reveal><h2 id="contact-title">{t.contactTitle1}<br />{t.contactTitle2} <span>{t.contactTitle3}<span class={styles.contactArrow} aria-hidden="true">↗</span></span></h2><p>{t.contactIntro1}<br />{' '}{t.contactIntro2}<br />{' '}<span>{t.contactIntro3}</span></p></div>
            <div class={styles.contactLinks}>{p.contacts.map(contact => contact.href ? <a href={contact.href} target={contact.href.startsWith('mailto:') ? undefined : '_blank'} rel="noopener noreferrer"><span>{contact.label}</span><span>{contact.value}</span><span aria-hidden="true">↗</span></a> : <div class={styles.contactPlaceholder}><span>{contact.label}</span><span>{contact.value}</span><span aria-hidden="true">↗</span><span class={styles.srOnly}>{t.contactMissing}</span></div>)}</div>
        </section>
      </main>
      <footer class={styles.footer}><span>© {year} {p.name}</span><span>{t.footer}</span><a href="#">{t.backTop} ↑</a></footer>
    </div>
    <script>
      import '../scripts/locale-router';
      const elements = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (!motionQuery.matches && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(entries => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.removeAttribute('data-pending');
              observer.unobserve(entry.target);
            }
          }
        }, { threshold: 0.08 });
        elements.forEach(element => {
          if (element.getBoundingClientRect().top > window.innerHeight) element.setAttribute('data-pending', '');
          observer.observe(element);
        });
        motionQuery.addEventListener('change', event => {
          if (event.matches) {
            elements.forEach(element => element.removeAttribute('data-pending'));
            observer.disconnect();
          }
        });
      }
    </script>
  </body>
</html>
